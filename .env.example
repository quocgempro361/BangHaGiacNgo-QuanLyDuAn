# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the app is hosted (e.g. https://giacngo.nhamycali.com)
APP_URL="MY_APP_URL"

# BOOTSTRAP_ADMIN_EMAIL: Verified project owner email allowed to initialize the first Admin account.
BOOTSTRAP_ADMIN_EMAIL="ngaothuyet2023@gmail.com"
