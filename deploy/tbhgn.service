# Mẫu systemd service cho TBHGN Production Server
# Lưu tại: /etc/systemd/system/tbhgn.service
# Điều chỉnh User, Group và WorkingDirectory cho đúng đường dẫn thực tế trên VPS.

[Unit]
Description=TBHGN Node.js Express Production Server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/tbhgn
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
EnvironmentFile=-/var/www/tbhgn/.env
ExecStart=/usr/bin/node /var/www/tbhgn/dist-server/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tbhgn

[Install]
WantedBy=multi-user.target
