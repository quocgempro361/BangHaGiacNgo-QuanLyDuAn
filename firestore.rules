rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Helpers
    // ---------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmailId(emailId) {
      return emailId is string && emailId.size() >= 3 && emailId.size() <= 254;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isBootstrapOwner() {
      return isVerifiedUser() && userEmail() == 'ngaothuyet2023@gmail.com';
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function inviteDocPath(emailLower) {
      return /databases/$(database)/documents/invites/$(emailLower);
    }

    function settingsDocPath(docId) {
      return /databases/$(database)/documents/settings/$(docId);
    }

    function hasUserProfile() {
      return isVerifiedUser() && exists(userDocPath(request.auth.uid));
    }

    function userProfile() {
      return get(userDocPath(request.auth.uid)).data;
    }

    function isActiveMember() {
      let uPath = userDocPath(request.auth.uid);
      return isVerifiedUser() && exists(uPath) && get(uPath).data.isActive == true;
    }

    function isAdmin() {
      let uPath = userDocPath(request.auth.uid);
      let p = get(uPath).data;
      return isVerifiedUser() && exists(uPath) && p.isActive == true && p.role == 'admin';
    }

    function isModerator() {
      let uPath = userDocPath(request.auth.uid);
      let p = get(uPath).data;
      return isVerifiedUser() && exists(uPath) && p.isActive == true && p.role == 'moderator';
    }

    function isTaskManager() {
      let uPath = userDocPath(request.auth.uid);
      let p = get(uPath).data;
      return isVerifiedUser() && exists(uPath) && p.isActive == true && (p.role == 'admin' || p.role == 'moderator');
    }

    function isMemberRole() {
      let uPath = userDocPath(request.auth.uid);
      let p = get(uPath).data;
      return isVerifiedUser() && exists(uPath) && p.isActive == true && p.role == 'member';
    }

    function isViewerRole() {
      let uPath = userDocPath(request.auth.uid);
      let p = get(uPath).data;
      return isVerifiedUser() && exists(uPath) && p.isActive == true && p.role == 'viewer';
    }

    function isActiveNonViewer() {
      let uPath = userDocPath(request.auth.uid);
      let p = get(uPath).data;
      return isVerifiedUser() && exists(uPath) && p.isActive == true && p.role != 'viewer';
    }

    function isApprover() {
      let uPath = userDocPath(request.auth.uid);
      let p = get(uPath).data;
      return isVerifiedUser() && exists(uPath) && p.isActive == true && (p.role == 'admin' || p.role == 'moderator' || p.canApprove == true);
    }

    // Permissions MUST bind strictly to Firebase UID (never text display names)
    function isAssignedToTask(taskData) {
      return request.auth.uid in taskData.assigneeUids;
    }

    function isScopedApproverForProfile(profile, taskData) {
      return (profile.role == 'admin' || profile.role == 'moderator' || profile.canApprove == true) && (
        isAssignedToTask(taskData)
        || ('approverUids' in taskData && request.auth.uid in taskData.approverUids)
      );
    }

    function taskDocPath(id) {
      return /databases/$(database)/documents/tasks/$(id);
    }

    function isParentValidForSubtask(parentData, isAdminUser, isMemberUser) {
      return parentData.parentId == null
        && parentData.archivedAt == null
        && (
          isAdminUser
          || (isMemberUser && isAssignedToTask(parentData))
        );
    }

    // Check existing parent via exists/get first; fall back to existsAfter/getAfter only when parent+child are created in the same batch
    function canCreateSubtaskUnder(parentId, isAdminUser, isMemberUser) {
      let pPath = taskDocPath(parentId);
      return exists(pPath)
        ? isParentValidForSubtask(get(pPath).data, isAdminUser, isMemberUser)
        : (
          existsAfter(pPath)
          && isParentValidForSubtask(getAfter(pPath).data, isAdminUser, isMemberUser)
        );
    }

    function optStrMax(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    // ---------------------------------------------------------
    // Validation Blueprints
    // ---------------------------------------------------------
    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'sheetAlias', 'role', 'canApprove', 'isActive', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'sheetAlias', 'role', 'canApprove', 'isActive', 'createdAt', 'updatedAt'])
        && data.uid == uid
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.sheetAlias is string && data.sheetAlias.size() <= 80
        && data.role in ['admin', 'moderator', 'member', 'viewer']
        && data.canApprove is bool
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvite(data, emailId) {
      return data.keys().hasAll(['email', 'displayName', 'sheetAlias', 'role', 'canApprove', 'isActive', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['email', 'displayName', 'sheetAlias', 'role', 'canApprove', 'isActive', 'createdBy', 'createdAt', 'updatedAt'])
        && data.email is string && data.email == emailId && isValidEmailId(data.email)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.sheetAlias is string && data.sheetAlias.size() <= 80
        && data.role in ['admin', 'moderator', 'member', 'viewer']
        && data.canApprove is bool
        && data.isActive is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuthSettings(data) {
      return data.keys().hasAll(['allowOpenGoogleLogin', 'updatedAt', 'updatedBy'])
        && data.keys().hasOnly(['allowOpenGoogleLogin', 'updatedAt', 'updatedBy'])
        && data.allowOpenGoogleLogin is bool
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'color', 'sortOrder', 'isActive', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.keys().hasOnly(['name', 'color', 'sortOrder', 'isActive', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.color is string && data.color.size() >= 4 && data.color.size() <= 20 && data.color.matches('^#[0-9a-fA-F]{6}$')
        && data.sortOrder is number
        && data.isActive is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128;
    }

    function isValidTask(data, taskId) {
      let catId = data.get('categoryId', null);
      let approvers = data.get('approverUids', []);
      let refLinks = data.get('referenceLinks', []);
      let resLinks = data.get('resultLinks', []);
      let flags = data.get('reviewFlags', []);
      let testRec = data.get('isTestRecord', false);
      return data.keys().hasAll(['id', 'displayCode', 'parentId', 'sortOrder', 'title', 'assignees', 'assigneeUids', 'status', 'version', 'updatedAt', 'updatedByUid', 'archivedAt'])
        && data.keys().hasOnly(['id', 'displayCode', 'parentId', 'sortOrder', 'title', 'categoryId', 'category', 'assignees', 'assigneeUids', 'approverUids', 'status', 'nextStep', 'dueDate', 'notes', 'referenceLinks', 'resultLinks', 'reviewFlags', 'version', 'updatedAt', 'updatedBy', 'updatedByUid', 'archivedAt', 'archivedBy', 'isTestRecord'])
        && data.id == taskId
        && data.displayCode is string && data.displayCode.size() >= 1 && data.displayCode.size() <= 24
        && (data.parentId == null || isValidId(data.parentId))
        && data.sortOrder is number
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && (catId == null || isValidId(catId))
        && optStrMax(data.get('category', null), 100)
        && data.assignees is list && data.assignees.size() <= 20 && (data.assignees.size() == 0 || data.assignees[0] is string)
        && data.assigneeUids is list && data.assigneeUids.size() <= 20 && (data.assigneeUids.size() == 0 || data.assigneeUids[0] is string)
        && approvers is list && approvers.size() <= 10 && (approvers.size() == 0 || approvers[0] is string)
        && (data.status == null || data.status in ['Đang làm', 'Chờ duyệt', 'Tạm dừng', 'Hoàn thành', 'Chưa bắt đầu'])
        && optStrMax(data.get('nextStep', null), 500)
        && optStrMax(data.get('dueDate', null), 20)
        && optStrMax(data.get('notes', null), 2000)
        && refLinks is list && refLinks.size() <= 20 && (refLinks.size() == 0 || refLinks[0] is map)
        && resLinks is list && resLinks.size() <= 20 && (resLinks.size() == 0 || resLinks[0] is map)
        && flags is list && flags.size() <= 10 && flags.hasOnly(['missing_assignee', 'missing_status', 'missing_hyperlink_url'])
        && data.version is int && data.version >= 1
        && data.updatedAt is timestamp
        && optStrMax(data.get('updatedBy', null), 120)
        && data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128
        && (data.archivedAt == null || data.archivedAt is timestamp)
        && optStrMax(data.get('archivedBy', null), 120)
        && testRec is bool;
    }

    function isValidComment(data, taskId, commentId) {
      return data.keys().hasAll(['id', 'taskId', 'authorUid', 'authorName', 'content', 'createdAt'])
        && data.keys().hasOnly(['id', 'taskId', 'authorUid', 'authorName', 'content', 'createdAt'])
        && data.id == commentId && isValidId(data.id)
        && data.taskId == taskId && isValidId(data.taskId)
        && data.authorUid == request.auth.uid
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 2000
        && data.createdAt is timestamp;
    }

    function isValidActivityLog(data, taskId, logId) {
      return data.keys().hasAll(['id', 'taskId', 'actorUid', 'actorName', 'action', 'summary', 'createdAt'])
        && data.keys().hasOnly(['id', 'taskId', 'actorUid', 'actorName', 'action', 'summary', 'createdAt'])
        && data.id == logId && isValidId(data.id)
        && data.taskId == taskId && isValidId(data.taskId)
        && data.actorUid == request.auth.uid
        && data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 120
        && data.action in ['create', 'update', 'status_change', 'approve', 'comment', 'archive', 'restore']
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500
        && data.createdAt is timestamp;
    }

    function matchesActiveInvite(data, iPath) {
      let inv = get(iPath).data;
      return inv.isActive == true
        && data.role == inv.role
        && data.canApprove == inv.canApprove
        && data.sheetAlias == inv.sheetAlias;
    }

    function isOpenGoogleLoginEnabled() {
      let sPath = settingsDocPath('auth');
      return exists(sPath) && get(sPath).data.allowOpenGoogleLogin == true;
    }

    function canCreateOwnUserProfile(uid) {
      let data = request.resource.data;
      let e = userEmail();
      let iPath = inviteDocPath(e);
      let hasInvite = exists(iPath);
      return isVerifiedUser()
        && isValidId(uid)
        && request.auth.uid == uid
        && isValidUserProfile(data, uid)
        && data.email.lower() == e
        && data.isActive == true
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && (
          (
            isBootstrapOwner()
            && data.role == 'admin'
            && data.canApprove == true
          )
          || (
            hasInvite
            && matchesActiveInvite(data, iPath)
          )
          || (
            !hasInvite
            && isOpenGoogleLoginEnabled()
            && data.role == 'viewer'
            && data.canApprove == false
            && data.sheetAlias == ''
          )
        );
    }

    function canCreateTask(taskId) {
      let data = request.resource.data;
      let uPath = userDocPath(request.auth.uid);
      let profile = get(uPath).data;
      let isManagerUser = profile.role == 'admin' || profile.role == 'moderator';
      let isMemberUser = profile.role == 'member';
      return isVerifiedUser()
        && isValidId(taskId)
        && exists(uPath)
        && profile.isActive == true
        && (isManagerUser || isMemberUser)
        && isValidTask(data, taskId)
        && data.version == 1
        && data.updatedAt == request.time
        && data.updatedByUid == request.auth.uid
        && data.archivedAt == null
        && (
          (isManagerUser && data.parentId == null)
          || (
            data.parentId != null
            && data.parentId != taskId
            && (
              isManagerUser
              || (
                isMemberUser
                && data.status != 'Hoàn thành'
                && data.assigneeUids == [request.auth.uid]
              )
            )
            && canCreateSubtaskUnder(data.parentId, isManagerUser, isMemberUser)
          )
        );
    }

    function isAdminParentValidForReparent(parentId, taskId) {
      let pPath = taskDocPath(parentId);
      return parentId != taskId && (
        exists(pPath)
          ? get(pPath).data.parentId == null
          : (existsAfter(pPath) && getAfter(pPath).data.parentId == null)
      );
    }

    function canUpdateTask(taskId) {
      let data = request.resource.data;
      let prev = resource.data;
      let uPath = userDocPath(request.auth.uid);
      let profile = get(uPath).data;
      let isManagerUser = profile.role == 'admin' || profile.role == 'moderator';
      let isMemberUser = profile.role == 'member';
      let scopedApprover = isScopedApproverForProfile(profile, prev);
      return isVerifiedUser()
        && isValidId(taskId)
        && exists(uPath)
        && profile.isActive == true
        && (isManagerUser || isMemberUser)
        && isValidTask(data, taskId)
        && data.id == prev.id
        && data.version == prev.version + 1
        && data.updatedAt == request.time
        && data.updatedByUid == request.auth.uid
        && (
          (
            isManagerUser
            && (
              data.parentId == prev.parentId
              || data.parentId == null
              || isAdminParentValidForReparent(data.parentId, taskId)
            )
            && data.diff(prev).affectedKeys().hasOnly(['displayCode', 'parentId', 'sortOrder', 'title', 'categoryId', 'category', 'assignees', 'assigneeUids', 'approverUids', 'status', 'nextStep', 'dueDate', 'notes', 'referenceLinks', 'resultLinks', 'reviewFlags', 'version', 'updatedAt', 'updatedBy', 'updatedByUid', 'archivedAt', 'archivedBy', 'isTestRecord'])
          )
          || (
            isMemberUser
            && prev.archivedAt == null
            && data.parentId == prev.parentId
            && data.assignees == prev.assignees
            && data.assigneeUids == prev.assigneeUids
            && data.archivedAt == prev.archivedAt
            && (
              (
                isAssignedToTask(prev)
                && data.diff(prev).affectedKeys().hasOnly(['status', 'nextStep', 'notes', 'referenceLinks', 'resultLinks', 'version', 'updatedAt', 'updatedBy', 'updatedByUid'])
                && (
                  (data.status == prev.status)
                  || (
                    data.status != 'Hoàn thành'
                    && prev.status != 'Hoàn thành'
                  )
                  || scopedApprover
                )
              )
              || (
                scopedApprover
                && data.diff(prev).affectedKeys().hasOnly(['status', 'nextStep', 'version', 'updatedAt', 'updatedBy', 'updatedByUid'])
              )
            )
          )
        );
    }

    function canCreateActivityLog(taskId, logId) {
      let data = request.resource.data;
      let uPath = userDocPath(request.auth.uid);
      let profile = get(uPath).data;
      let tPath = taskDocPath(taskId);
      let cPath = /databases/$(database)/documents/tasks/$(taskId)/comments/$(logId);
      return isVerifiedUser()
        && isValidId(taskId)
        && isValidId(logId)
        && exists(uPath)
        && profile.isActive == true
        && profile.role != 'viewer'
        && isValidActivityLog(data, taskId, logId)
        && data.createdAt == request.time
        && (
          (
            existsAfter(tPath)
            && getAfter(tPath).data.updatedAt == request.time
            && getAfter(tPath).data.updatedByUid == request.auth.uid
          )
          || (
            data.action == 'comment'
            && existsAfter(cPath)
            && getAfter(cPath).data.authorUid == request.auth.uid
            && getAfter(cPath).data.createdAt == request.time
          )
        );
    }

    // ---------------------------------------------------------
    // Collection: /users/{uid} (PII Isolated: get owner/manager; list manager; write admin only)
    // ---------------------------------------------------------
    match /users/{uid} {
      allow get: if isVerifiedUser() && isValidId(uid) && (request.auth.uid == uid || isTaskManager());
      allow list: if isTaskManager();

      allow create: if canCreateOwnUserProfile(uid);

      allow update: if isAdmin()
        && isValidId(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'sheetAlias', 'role', 'canApprove', 'isActive', 'updatedAt']);

      allow delete: if false;
    }

    // ---------------------------------------------------------
    // Collection: /invites/{emailId} (Admin-managed allowlist)
    // ---------------------------------------------------------
    match /invites/{emailId} {
      allow get: if isVerifiedUser() && isValidEmailId(emailId) && (userEmail() == emailId || isAdmin());
      allow list: if isAdmin();

      allow create: if isAdmin()
        && isValidEmailId(emailId)
        && isValidInvite(incoming(), emailId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidEmailId(emailId)
        && isValidInvite(incoming(), emailId)
        && incoming().email == existing().email
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'sheetAlias', 'role', 'canApprove', 'isActive', 'updatedAt']);

      allow delete: if isAdmin() && isValidEmailId(emailId);
    }

    // ---------------------------------------------------------
    // Collection: /settings/{docId} (Admin-controlled app auth settings)
    // ---------------------------------------------------------
    match /settings/{docId} {
      allow get: if isVerifiedUser() && docId == 'auth';
      allow list: if false;

      allow create, update: if isAdmin()
        && docId == 'auth'
        && isValidAuthSettings(incoming());

      allow delete: if false;
    }

    // ---------------------------------------------------------
    // Collection: /categories/{categoryId}
    // ---------------------------------------------------------
    match /categories/{categoryId} {
      allow get: if isActiveMember() && isValidId(categoryId);
      allow list: if isActiveMember();

      allow create: if isTaskManager()
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isTaskManager()
        && isValidId(categoryId)
        && isValidCategory(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color', 'sortOrder', 'isActive', 'updatedAt', 'updatedBy']);

      allow delete: if isTaskManager() && isValidId(categoryId);
    }

    // ---------------------------------------------------------
    // Collection: /tasks/{taskId}
    // ---------------------------------------------------------
    match /tasks/{taskId} {
      allow get: if isActiveMember() && isValidId(taskId);
      allow list: if isActiveMember();

      // Create:
      // - Admin & Moderator can create parent (parentId == null) or 2nd-level child task
      // - Member can create ONLY a 2nd-level child task under an assigned parent (never 3rd-level, never Hoàn thành)
      allow create: if canCreateTask(taskId);

      allow update: if canUpdateTask(taskId);

      allow delete: if false;

      // Subcollection: /tasks/{taskId}/comments/{commentId}
      match /comments/{commentId} {
        allow get: if isActiveMember() && isValidId(taskId) && isValidId(commentId);
        allow list: if isActiveMember() && isValidId(taskId);

        allow create: if isActiveNonViewer()
          && isValidId(taskId)
          && isValidId(commentId)
          && exists(/databases/$(database)/documents/tasks/$(taskId))
          && isValidComment(incoming(), taskId, commentId)
          && incoming().createdAt == request.time;

        allow update, delete: if false;
      }

      // Subcollection: /tasks/{taskId}/activityLogs/{logId}
      match /activityLogs/{logId} {
        allow get: if isActiveMember() && isValidId(taskId) && isValidId(logId);
        allow list: if isActiveMember() && isValidId(taskId);

        allow create: if canCreateActivityLog(taskId, logId);

        allow update, delete: if false;
      }
    }

    match /test/{docId} {
      allow read, write: if false;
    }
  }
}
